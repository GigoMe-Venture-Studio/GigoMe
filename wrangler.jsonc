{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gigome",
  "compatibility_date": "2026-10-30",
  // A tiny Worker script, only for the daily Supabase ping (worker/index.js).
  // Pages are still served as static assets without running it.
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    // Lets the Worker hand the rare request it does get back to the assets.
    "binding": "ASSETS",
    // Unknown paths return index.html, so refreshing any page works. Browser
    // page loads get it straight from the assets, without the Worker.
    "not_found_handling": "single-page-application"
  },
  // Every day at 04:17 UTC: the Supabase ping, so the free project never pauses.
  "triggers": {
    "crons": ["17 4 * * *"]
  },
  // SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY are set in the Cloudflare
  // dashboard (Worker > Settings > Variables and Secrets). Keep them on deploy.
  "keep_vars": true,
  // Workers Logs: keeps the Worker's console output (e.g. "Supabase ping OK")
  // in the dashboard (Worker > Observability > Logs). Only runs of the Worker
  // script are logged: the daily ping and the rare request for a file that
  // doesn't exist. Pages and files served as static assets aren't, so this
  // stays far inside the free plan's daily log allowance. Every run is kept
  // (sampling 1 = 100%); there are only a handful a day.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // Needed for preview builds of PR branches (wrangler preview).
  "previews": {}
}
