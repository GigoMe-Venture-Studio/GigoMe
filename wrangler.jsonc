{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gigome",
  "compatibility_date": "2026-10-30",
  // Static site: no Worker script, only the Vite build output.
  "assets": {
    "directory": "./dist",
    // Unknown paths return index.html, so refreshing any page works.
    "not_found_handling": "single-page-application"
  },
  // Needed for preview builds of PR branches (wrangler preview).
  "previews": {}
}
