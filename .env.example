# Copy to .env.local and fill in. Never commit real values.
# Both are build-time variables: Vite puts them into the browser bundle.
# Find them in the Supabase dashboard: Project Settings > API Keys / Data API.

# https://<project-ref>.supabase.co
VITE_SUPABASE_URL=

# The publishable key (starts with sb_publishable_). Never the secret or service_role key.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: Cloudflare Turnstile site key (public) for the login form. When it
# is empty, the login form has no bot check. The secret key goes only in the
# Supabase dashboard (Authentication > Attack Protection), never here.
VITE_TURNSTILE_SITE_KEY=
